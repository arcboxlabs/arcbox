+func TestContainerFSViewCloseRetainsMountsOnJoinFailure(t *testing.T) {
+	joinErr := errors.New("thread exit was not confirmed")
+	view := &containerFSView{
+		todo: make(chan future),
+		wait: func() error { return joinErr },
+	}
+	// Nil mount owners make an unsafe cleanup after a failed join fail this test.
+	assert.ErrorIs(t, view.Close(), joinErr)
+	_, open := <-view.todo
+	assert.Assert(t, !open)
+}
 
