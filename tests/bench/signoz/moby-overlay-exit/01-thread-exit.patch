+// GoInMountNS runs setupfn and fn in a new mount namespace on a locked thread.
+// The startup and callback semantics are the same as Go.
+// If wait is non-nil, the caller must call wait exactly once, even when err is non-nil.
+// A successful wait confirms that the worker has finished its exit task work.
+// The wait function owns and closes the thread pidfd. Linux 6.9 or later is required.
+func GoInMountNS(setupfn func() error, fn func()) (wait func() error, err error) {
+	pidfd := -1
+	err = goInNamespace(unix.CLONE_NEWNS, setupfn, fn, func() error {
+		var openErr error
+		pidfd, openErr = unix.PidfdOpen(unix.Gettid(), unix.PIDFD_THREAD)
+		return os.NewSyscallError("pidfd_open", openErr)
+	})
+	if pidfd < 0 {
+		return nil, err
+	}
+	return func() error { return waitThreadExit(pidfd) }, err
+}
+
+func waitThreadExit(pidfd int) (retErr error) {
+	// A Go callback can return before exit_task_work releases the thread's mount references.
+	defer func() {
+		retErr = errors.Join(retErr, os.NewSyscallError("close pidfd", unix.Close(pidfd)))
+	}()
+	poll := []unix.PollFd{{Fd: int32(pidfd), Events: unix.POLLIN}}
+	for {
+		if _, err := unix.Poll(poll, -1); err != nil {
+			if errors.Is(err, unix.EINTR) {
+				continue
+			}
+			return os.NewSyscallError("poll pidfd", err)
+		}
+		events := poll[0].Revents
+		if events&(unix.POLLERR|unix.POLLNVAL) == 0 && events&(unix.POLLIN|unix.POLLHUP) != 0 {
+			return nil
+		}
+		return fmt.Errorf("poll pidfd: unexpected events %#x", events)
+	}
+}
